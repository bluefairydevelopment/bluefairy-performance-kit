{
    "name": "bluefairy/performance-kit",
    "description": "Removes WordPress front-end weight (emoji, oEmbed, heartbeat) and adds native lazy loading.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=4G"
    }
}
